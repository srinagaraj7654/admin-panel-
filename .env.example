# MockTest admin panel — example settings with FAKE values.
# Copy to .env.development (local, gitignored) and replace every value with the real one.
# Never commit real keys.

# Supabase (same project as the MockTest website) — Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-supabase-publishable-or-anon-key

# Existing MockTest API (used only when VITE_ACCESS_API_URL is empty)
VITE_API_URL=https://api.example.com
VITE_ADMIN_KEY=your-admin-key

# Admin access server (server-for-admin-panel-) — required: it decides who is an admin
VITE_ACCESS_API_URL=http://localhost:4000

# Student website (used for links back to the site)
VITE_MAIN_SITE_URL=http://localhost:3000
